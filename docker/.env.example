# =============================================================================
# The ONLY file that differs between machines. Copy to .env and edit.
#   cp docker/.env.example docker/.env
# .env is gitignored. .env.example is committed.
# =============================================================================

# --- Isaac Sim version -------------------------------------------------------
# 6.0.1 = current. 5.1.0 = pre-6.0 sensor API. See README "Which Isaac Sim".
ISAACSIM_VERSION=6.0.1

# --- Streaming ---------------------------------------------------------------
# The address the MacBook connects TO. Use the server's Tailscale IP.
# A wrong value here is the single most likely cause of "connects, black
# screen" -- signaling succeeds against the wrong interface and media never
# arrives. 127.0.0.1 only works if client and server are the same machine.
ISAACSIM_HOST=127.0.0.1

# TCP signaling. UDP media. BOTH must be open on the host firewall --
# opening only the TCP port gives you a connection and no picture.
ISAACSIM_SIGNAL_PORT=49100
ISAACSIM_STREAM_PORT=47998

# --- Before the first build --------------------------------------------------
#   docker login nvcr.io
#   Username: $oauthtoken       <- literally this string, including the $
#   Password: <NGC API key from ngc.nvidia.com>
# Do this FIRST. Skipping it fails the pull with an auth error that reads like
# a network problem.
